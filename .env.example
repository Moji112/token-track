# Copy this file to .env and fill in your own values. .env is gitignored —
# never commit real secrets.

# Optional. Set this to require a password to open the app or call its API
# (a small login page, password only). Leave unset to run without one.
TRAILHEAD_PASSWORD=

# Optional. Port the server listens on. Defaults to 3000.
PORT=3000

# --- Vercel Cron only — leave these unset on Railway/Render/local, where the
# in-app Settings UI (webhook + threshold) works normally and persists to
# data/settings.json. On Vercel, that file lives in /tmp and isn't shared
# between invocations, so a cron-triggered check wouldn't see anything saved
# through the UI. Setting these instead makes them the same for every
# invocation. See README.md "Deploying to Vercel anyway" for the full setup.
TRAILHEAD_LIQUIDITY_THRESHOLD=
TRAILHEAD_WEBHOOK_URL=

# Optional but recommended alongside the two above: Vercel automatically
# sends this as a Bearer token when it calls /api/cron/tick, so anyone else
# hitting that path without it gets rejected instead of triggering a check.
CRON_SECRET=
